# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://autopeer:changeme@db:5432/autopeer?sslmode=disable  # change sslmode=require for production
JWT_SECRET=change-this-to-a-random-secret

# ── Database (used by docker-compose db service) ──────────────────────────────
DB_PASSWORD=changeme

# ── Admin bootstrap (applied on every startup) ────────────────────────────────
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-this-password

# ── Network ────────────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080
CORS_ORIGIN=https://autopeer.example.com
# Public URL used in agent download links
EXTERNAL_URL=https://autopeer.example.com

# ── DN42 Registry ──────────────────────────────────────────────────────────────
DN42_REGISTRY_TOKEN=

# ── Email (SMTP, plain text only) ───────────────────────────────────────────────
# Email is delivered over SMTP. SMTP_HOST and SMTP_FROM are required to enable it;
# leave SMTP_HOST empty to disable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=AutoPeer
# TLS mode: starttls (default, e.g. port 587), tls (implicit, e.g. port 465), or none (dev only).
SMTP_TLS=starttls

# ── Notifications (comma-separated admin emails) ───────────────────────────────
ADMIN_NOTIFY_EMAILS=

# ── Redis (optional) ───────────────────────────────────────────────────────────
# Only REDIS_URL is needed to enable Redis, for example:
# REDIS_URL=redis://default:password@redis.example.com:6379/0
REDIS_URL=
# Fail startup if REDIS_URL is set but Redis is unavailable.
REDIS_REQUIRED=false
# Prefix for all Redis keys, useful when sharing one Redis database.
REDIS_KEY_PREFIX=autopeer:center:
# Local bbolt fallback is used only when Redis is unavailable.
CACHE_LOCAL_FALLBACK=true

# ── ClickHouse (optional: DN42 traffic-sampling analytics) ─────────────────────
# Leave empty to disable traffic analytics entirely (reports dropped, API 503,
# frontend panel hidden). When set, point it at a ClickHouse native endpoint:
# CLICKHOUSE_URL=clickhouse://autopeer:changeme@clickhouse:9000/autopeer
CLICKHOUSE_URL=
# Fail startup if CLICKHOUSE_URL is set but ClickHouse is unavailable.
CLICKHOUSE_REQUIRED=false
# Password for the docker-compose clickhouse service (used only with that service).
CLICKHOUSE_PASSWORD=changeme

# ── Persistent paths (keep in sync with docker-compose volumes) ────────────────
AGENT_RELEASE_DIR=/var/lib/autopeer-center/releases
CACHE_DIR=/var/lib/autopeer-center/cache/cache.db
CENTER_KEY_PATH=/var/lib/autopeer-center/center_keys.json

# ── Cloudflare Turnstile (leave empty to disable) ──────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Flap monitor (flapalerted-agent) identities are now managed by admins in the
# dashboard and stored in the flap_agents table — no env configuration needed.

# ── Inactivity sweep (daily peer inactivity warnings and auto-deletion) ─────────
# Enables the daily sweep that sends mandatory warning emails at 45/50/60 days of
# peer inactivity and deletes the peer at 60 days. Notifications bypass per-user
# preference gates (always delivered).
INACTIVITY_SWEEP_ENABLED=true
# Days of inactivity before the first (45d), second (50d), and final (60d) warning.
INACTIVITY_WARN_FIRST_DAYS=45
INACTIVITY_WARN_SECOND_DAYS=50
INACTIVITY_DELETE_DAYS=60
# When true, logs intended actions without sending notifications or deleting.
INACTIVITY_DRY_RUN=false

# ── Sentry (leave DSN empty to disable) ────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENABLE_METRICS=false
SENTRY_DEBUG=false
